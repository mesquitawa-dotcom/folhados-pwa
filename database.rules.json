{
  "rules": {
    ".read": false,
    ".write": false,
    "fdo_dispositivos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "fdo_lotes": {
      ".read": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
    },
    "fdo_laminacoes": {
      ".read": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
    },
    "fdo_lote_seq": {
      ".read": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
    },
    "fdo_operadores": {
      ".read": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
    },
    "fdo_farinha_lotes_atuais": {
      ".read": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
    },
    "fdo_acessos": {
      ".read": false,
      "$id": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true && !data.exists() && newData.exists()"
      }
    },
    "fdo_v25": {
      ".read": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true",
      "lotes": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "laminacoes": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "partidas": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "formas": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "meta": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "estoque": {
        "movimentos": {
          "$id": {
            ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true && !data.exists() && newData.exists()"
          }
        },
        "contagens": {
          ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
        },
        "configuracoes": {
          ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
        },
        "meta": {
          ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
        }
      },
      "receitas_observacoes": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "receitas_definitivas": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      },
      "receitas_auditoria": {
        "$id": {
          ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true && !data.exists() && newData.exists()"
        }
      },
      "receitas_meta": {
        ".write": "auth != null && root.child('fdo_dispositivos').child(auth.uid).child('ativo').val() === true"
      }
    },
    "fdo_ponto_gerentes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "fdo_ponto_vinculos": {
      ".read": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
        ".validate": "newData.hasChildren(['funcionarioId','ativo']) && newData.child('funcionarioId').isString() && newData.child('ativo').isBoolean()"
      }
    },
    "fdo_ponto_colaboradores": {
      ".read": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
      "$fid": {
        ".read": "auth != null && root.child('fdo_ponto_vinculos').child(auth.uid).child('ativo').val() === true && root.child('fdo_ponto_vinculos').child(auth.uid).child('funcionarioId').val() === $fid",
        ".write": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
        ".validate": "newData.hasChildren(['nome','tipo','ativo']) && newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 90 && (newData.child('tipo').val() === 'mensalista' || newData.child('tipo').val() === 'horista') && newData.child('ativo').isBoolean()"
      }
    },
    "fdo_ponto_regras": {
      ".read": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
      "$fid": {
        ".read": "auth != null && root.child('fdo_ponto_vinculos').child(auth.uid).child('ativo').val() === true && root.child('fdo_ponto_vinculos').child(auth.uid).child('funcionarioId').val() === $fid",
        "$rev": {
          ".write": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['dias','tipo','gerenteUid','servidorTs']) && newData.child('gerenteUid').val() === auth.uid && newData.child('servidorTs').val() === now"
        }
      }
    },
    "fdo_ponto_financeiro": {
      ".read": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
      "$fid": {
        "$rev": {
          ".write": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['centavos','tipo','gerenteUid','servidorTs']) && newData.child('gerenteUid').val() === auth.uid && newData.child('centavos').isNumber() && newData.child('centavos').val() >= 0 && newData.child('servidorTs').val() === now"
        }
      }
    },
    "fdo_ponto_config": {
      "area": {
        ".read": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true || (auth != null && root.child('fdo_ponto_vinculos').child(auth.uid).child('ativo').val() === true && root.child('fdo_ponto_vinculos').child(auth.uid).child('funcionarioId').val() === root.child('fdo_ponto_vinculos').child(auth.uid).child('funcionarioId').val())",
        ".write": "auth != null && root.child('fdo_ponto_gerentes').child(auth.uid).child('ativo').val() === true",
        ".validate": "newData.hasChildren(['lat','lng','raio']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('raio').isNumber() && newData.child('raio').val() >= 20 && newData.child('raio').val() <= 2000"
      }
    }
  }
}
